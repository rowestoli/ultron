# Copy to .env and fill in what you have. Everything is optional in mock mode.

# --- LLM ---
ANTHROPIC_API_KEY=
# Only for llm.provider=openai_compatible services that need a key (Ollama doesn't)
OPENAI_API_KEY=
# Override config.yaml's provider without editing it (mock | anthropic | openai_compatible)
ULTRON_LLM_PROVIDER=

# --- Etsy (developer.etsy.com -> Your Apps) ---
# keystring:shared_secret, joined with a colon
ETSY_API_KEY=
# Must match a callback URL registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:3003/callback
# Filled automatically by `python -m ultron etsy-auth` (stored in data/etsy_token.json)
ETSY_SHOP_ID=

# --- Pinterest (developers.pinterest.com) ---
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
